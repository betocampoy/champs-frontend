{% macro button(options = {}) %}
    {% set id = options.id|default('champsNotificationCenter') %}
    {% set title = options.title|default('Notificações') %}
    {% set icon = options.icon|default('bi-bell') %}
    {% set url = options.url|default('') %}
    {% set counterUrl = options.counterUrl|default(url) %}
    {% set readUrl = options.readUrl|default('') %}
    {% set deleteUrl = options.deleteUrl|default('') %}
    {% set refresh = options.refresh|default(60) %}

    {% set openIfUnread = options.openIfUnread|default(false) %}
    {% set openIfUnreadOnce = options.openIfUnreadOnce|default(true) %}
    {% set readAction = options.readAction|default('notification-center-mark-read') %}
    {% set deleteAction = options.deleteAction|default('notification-center-delete') %}

    <button
            type="button"
            class="{{ options.buttonClass|default('btn btn-light position-relative') }}"
            title="{{ title }}"
            data-champs-tour="{{ options.tour|default('notification-center') }}"
            data-champs-notification-center
            data-champs-notification-center-target="#{{ id }}"
            data-champs-notification-center-url="{{ url }}"
            data-champs-notification-center-counter-url="{{ counterUrl }}"
            data-champs-notification-center-read-url="{{ readUrl }}"
            data-champs-notification-center-delete-url="{{ deleteUrl }}"
            data-champs-notification-center-refresh="{{ refresh }}"
            data-champs-notification-center-open-if-unread="{{ openIfUnread ? 'true' : 'false' }}"
            data-champs-notification-center-open-if-unread-once="{{ openIfUnreadOnce ? 'true' : 'false' }}"
            data-champs-notification-center-read-action="{{ readAction }}"
            data-champs-notification-center-delete-action="{{ deleteAction }}"
    >
        <i class="bi {{ icon }}"></i>

        <span
                class="{{ options.counterClass|default('position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none') }}"
                style="{{ options.counterStyle|default('') }}"
                data-champs-notification-center-counter
        >0</span>
    </button>
{% endmacro %}


{% macro sidebar(options = {}) %}
    {% set id = options.id|default('champsNotificationCenter') %}
    {% set title = options.title|default('Notificações') %}
    {% set position = options.position|default('end') %}

    {# Ações em massa (opcionais): cada ícone só aparece se a URL for informada.
       Disparadas via data-champs-ajax com module "notification-center", então o
       NotificationCenter.js recarrega lista/contador no champs:ajax:success; ele
       também habilita/desabilita os ícones conforme a lista carregada. #}
    {% set markAllReadUrl = options.markAllReadUrl|default('') %}
    {% set deleteAllUrl = options.deleteAllUrl|default('') %}
    {% set markAllReadAction = options.markAllReadAction|default('notification-center-mark-all-read') %}
    {% set deleteAllAction = options.deleteAllAction|default('notification-center-delete-all') %}
    {% set markAllReadTitle = options.markAllReadTitle|default('Marcar todas como lidas') %}
    {% set deleteAllTitle = options.deleteAllTitle|default('Excluir todas') %}
    {% set deleteAllConfirm = options.deleteAllConfirm|default('Deseja excluir todas as notificações?') %}
    {% set closeLabel = options.closeLabel|default('Fechar') %}

    <div
            id="{{ id }}"
            class="offcanvas offcanvas-{{ position }}"
            tabindex="-1"
            aria-labelledby="{{ id }}Label"
    >
        <div class="offcanvas-header border-bottom gap-2">
            <h5 class="offcanvas-title me-auto" id="{{ id }}Label">
                {{ title }}
            </h5>

            {% if markAllReadUrl %}
                <button
                        type="button"
                        class="btn btn-sm btn-link text-secondary p-1"
                        title="{{ markAllReadTitle }}"
                        aria-label="{{ markAllReadTitle }}"
                        disabled
                        data-champs-notification-center-bulk="mark-all-read"
                        data-champs-ajax="true"
                        data-champs-ajax-module="notification-center"
                        data-champs-ajax-route="{{ markAllReadUrl }}"
                        data-champs-ajax-field-action="{{ markAllReadAction }}"
                        data-champs-loader-target="#{{ id }} [data-champs-notification-center-list]"
                >
                    <i class="bi {{ options.markAllReadIcon|default('bi-check2-all') }} fs-5"></i>
                </button>
            {% endif %}

            {% if deleteAllUrl %}
                <button
                        type="button"
                        class="btn btn-sm btn-link text-danger p-1"
                        title="{{ deleteAllTitle }}"
                        aria-label="{{ deleteAllTitle }}"
                        disabled
                        data-champs-notification-center-bulk="delete-all"
                        data-champs-ajax="true"
                        data-champs-ajax-module="notification-center"
                        data-champs-ajax-route="{{ deleteAllUrl }}"
                        data-champs-ajax-field-action="{{ deleteAllAction }}"
                        data-champs-ajax-confirm="{{ deleteAllConfirm }}"
                        data-champs-loader-target="#{{ id }} [data-champs-notification-center-list]"
                >
                    <i class="bi {{ options.deleteAllIcon|default('bi-trash') }} fs-5"></i>
                </button>
            {% endif %}

            <button
                    type="button"
                    class="btn-close ms-1"
                    data-bs-dismiss="offcanvas"
                    data-champs-notification-center-close
                    aria-label="{{ closeLabel }}"
            ></button>
        </div>

        <div class="offcanvas-body p-0">

            <div
                    id="{{ id }}Message"
                    class="px-3 pt-3"
                    data-champs-notification-center-message
            ></div>

            <div
                    class="list-group list-group-flush"
                    data-champs-notification-center-list
            >
                <div class="p-3 text-muted small">
                    Carregando notificações...
                </div>
            </div>
        </div>
    </div>
{% endmacro %}