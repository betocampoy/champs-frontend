{# ============================================================
   Tema de formulário Symfony que liga form_row()/form_widget() às
   macros ui.input/ui.select (templates/components/ui/_form.html.twig),
   trazendo formStyle (prefixed/inline/floating) + erro de validação
   pros forms Symfony sem precisar reescrever cada template.

   Cobre só os tipos "input único" (text/email/password/number/url/tel/
   search) e choice/entity de valor único, não-expandido, sem grupos —
   qualquer outro tipo (checkbox, file, coleção, choice expandido ou
   múltiplo, choice agrupado) cai automaticamente pro tema configurado
   em seguida na lista de form_themes (normalmente bootstrap_5_layout),
   sem precisar de nada especial aqui — é assim que a resolução de
   blocks do Symfony já funciona.

   Registro (config/packages/twig.yaml):
     form_themes: ['@ChampsFrontend/form/champs_theme.html.twig', 'bootstrap_5_layout.html.twig']
   Ou por form, pra pilotar antes de virar padrão global:
     {% form_theme form '@ChampsFrontend/form/champs_theme.html.twig' %}
============================================================ #}

{% use 'bootstrap_5_layout.html.twig' with choice_row as bootstrap_choice_row, date_row as bootstrap_date_row %}

{% block text_row %}
    {%- import '@ChampsFrontend/components/ui/_form.html.twig' as ui -%}
    {%- set formStyle = champs_form_style() -%}
    {%- set errorMessages = [] -%}
    {%- for error in form.vars.errors -%}
        {%- set errorMessages = errorMessages|merge([error.message]) -%}
    {%- endfor -%}
    {%- set fieldAttr = attr is defined ? form.vars.attr|default({})|merge(attr) : form.vars.attr|default({}) -%}
    {%- set extraClass = fieldAttr.class|default('') -%}
    {%- set fieldAttrNoClass = fieldAttr|filter((v, k) => k != 'class') -%}
    {%- set fieldLabel = label is defined ? label : form.vars.label -%}
    {%- if fieldLabel is same as(false) -%}
        {%- set fieldLabel = '' -%}
    {%- elseif fieldLabel is null -%}
        {%- set fieldLabel = form.vars.name|humanize -%}
    {%- endif -%}
    {%- set fieldButtons = buttons is defined ? buttons : [] -%}

    {{ ui.input({
        style: formStyle,
        type: inputType|default('text'),
        name: form.vars.full_name,
        id: form.vars.id,
        label: fieldLabel,
        value: form.vars.value,
        placeholder: fieldAttr.placeholder|default(''),
        required: form.vars.required,
        disabled: form.vars.disabled,
        inputClasses: extraClass,
        wrapperClasses: 'mb-3',
        attrs: fieldAttrNoClass,
        help: help|default(form.vars.help),
        errors: errorMessages,
        buttons: fieldButtons,
    }) }}
{% endblock %}

{% block textarea_row %}
    {%- import '@ChampsFrontend/components/ui/_form.html.twig' as ui -%}
    {%- set formStyle = champs_form_style() -%}
    {%- set errorMessages = [] -%}
    {%- for error in form.vars.errors -%}
        {%- set errorMessages = errorMessages|merge([error.message]) -%}
    {%- endfor -%}
    {%- set fieldAttr = attr is defined ? form.vars.attr|default({})|merge(attr) : form.vars.attr|default({}) -%}
    {%- set extraClass = fieldAttr.class|default('') -%}
    {%- set fieldAttrNoClass = fieldAttr|filter((v, k) => k != 'class' and k != 'rows') -%}
    {%- set fieldLabel = label is defined ? label : form.vars.label -%}
    {%- if fieldLabel is same as(false) -%}
        {%- set fieldLabel = '' -%}
    {%- elseif fieldLabel is null -%}
        {%- set fieldLabel = form.vars.name|humanize -%}
    {%- endif -%}
    {%- set fieldButtons = buttons is defined ? buttons : [] -%}

    {{ ui.textarea({
        style: formStyle,
        name: form.vars.full_name,
        id: form.vars.id,
        label: fieldLabel,
        value: form.vars.value,
        placeholder: fieldAttr.placeholder|default(''),
        required: form.vars.required,
        disabled: form.vars.disabled,
        rows: fieldAttr.rows|default(5),
        textareaClasses: extraClass,
        wrapperClasses: 'mb-3',
        attrs: fieldAttrNoClass,
        help: help|default(form.vars.help),
        help_raw: helpRaw|default(false),
        errors: errorMessages,
        buttons: fieldButtons,
    }) }}
{% endblock %}

{% block email_row %}{% set inputType = 'email' %}{{ block('text_row') }}{% endblock %}
{% block password_row %}{% set inputType = 'password' %}{{ block('text_row') }}{% endblock %}
{% block number_row %}{% set inputType = 'number' %}{{ block('text_row') }}{% endblock %}
{% block url_row %}{% set inputType = 'url' %}{{ block('text_row') }}{% endblock %}
{% block tel_row %}{% set inputType = 'tel' %}{{ block('text_row') }}{% endblock %}
{% block search_row %}{% set inputType = 'search' %}{{ block('text_row') }}{% endblock %}
{# ColorType herda de TextType — sem um color_row próprio, a resolução de
   blocks do Symfony cai no text_row acima (que também serve de fallback
   pro tipo pai) e o picker nativo (type="color") nunca aparece. #}
{% block color_row %}{% set inputType = 'color' %}{{ block('text_row') }}{% endblock %}

{# DateType/TimeType/DateTimeType com widget=single_text renderizam como
   um único <input>, igual TextType — só que o Symfony resolve o nome do
   bloco pelo TIPO do campo (date_row/time_row/datetime_row), não cai
   automaticamente no text_row como email_row/password_row/etc fazem
   acima (esses herdam de TextType de verdade; Date/Time/DateTime não).
   Sem isto, esses campos sempre caíam no date_row do bootstrap_5_layout
   (importado via `use` acima), que nunca soube nada sobre formStyle —
   bug real encontrado 2026-09-10. Guardado por widget: só refina quando
   é single_text (um input só); widget=choice (o default do Symfony pra
   DateType, vira 3 selects de dia/mês/ano) continua caindo no bootstrap
   original, nunca cabe no molde de "um input só" do text_row. #}
{% block date_row %}
    {%- if form.vars.widget == 'single_text' -%}
        {%- set inputType = 'date' -%}
        {{ block('text_row') }}
    {%- else -%}
        {{ block('bootstrap_date_row') }}
    {%- endif -%}
{% endblock %}

{% block choice_row %}
    {%- if form.vars.expanded or form.vars.multiple -%}
        {{ block('bootstrap_choice_row') }}
    {%- else -%}
        {%- set isGrouped = false -%}
        {%- for choice in form.vars.choices -%}
            {%- if choice.label is not defined or choice.value is not defined -%}
                {%- set isGrouped = true -%}
            {%- endif -%}
        {%- endfor -%}

        {%- if isGrouped -%}
            {{ block('bootstrap_choice_row') }}
        {%- else -%}
            {%- import '@ChampsFrontend/components/ui/_form.html.twig' as ui -%}
            {%- set formStyle = champs_form_style() -%}
            {%- set errorMessages = [] -%}
            {%- for error in form.vars.errors -%}
                {%- set errorMessages = errorMessages|merge([error.message]) -%}
            {%- endfor -%}
            {%- set opts = [] -%}
            {%- for choice in form.vars.choices -%}
                {%- set opts = opts|merge([{value: choice.value, label: choice.label}]) -%}
            {%- endfor -%}
            {%- set fieldLabel = label is defined ? label : form.vars.label -%}
            {%- if fieldLabel is same as(false) -%}
                {%- set fieldLabel = '' -%}
            {%- elseif fieldLabel is null -%}
                {%- set fieldLabel = form.vars.name|humanize -%}
            {%- endif -%}
            {%- set fieldAttr = attr is defined ? form.vars.attr|default({})|merge(attr) : form.vars.attr|default({}) -%}
            {%- set extraClass = fieldAttr.class|default('') -%}
            {%- set fieldAttrNoClass = fieldAttr|filter((v, k) => k != 'class') -%}

            {{ ui.select({
                style: formStyle,
                name: form.vars.full_name,
                id: form.vars.id,
                label: fieldLabel,
                placeholder: form.vars.placeholder|default(''),
                selected: form.vars.value,
                required: form.vars.required,
                disabled: form.vars.disabled,
                options: opts,
                wrapperClasses: 'mb-3',
                selectClasses: extraClass,
                attrs: fieldAttrNoClass,
                help: help|default(form.vars.help),
                errors: errorMessages,
            }) }}
        {%- endif -%}
    {%- endif -%}
{% endblock %}
